# ── Hilbert-RL Optimizer — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   Then edit .env with your actual values

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ── MLflow tracking ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns  # local | http://your-mlflow-server:5000

# ── Model paths ───────────────────────────────────────────────────────────────
MODEL_PATH=./models/agent.onnx

# ── Training ──────────────────────────────────────────────────────────────────
SEED=42
DEVICE=cpu                    # cpu | cuda | mps
